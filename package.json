{
  "name": "fungular",
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "start": "nx serve demo-app",
    "lint:all": "npx nx run-many --target=lint --all",
    "test": "nx test",
    "test:all": "npx nx run-many --target=test --all",
    "deps:relock": "node -e \"require('fs').rmSync('package-lock.json',{force:true})\" && npx --yes npm@11.21.2 install --package-lock-only --ignore-scripts --no-audit --no-fund && npm ci --no-audit --no-fund",
    "prepare": "husky",
    "pages:dev": "wrangler pages dev dist/apps/demo-app/browser --port 4200",
    "pages:deploy": "npx nx build demo-app --configuration=production && npx wrangler pages deploy dist/apps/demo-app/browser"
  },
  "browserslist": [
    "baseline widely available"
  ],
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=10.9.8"
  },
  "dependencies": {
